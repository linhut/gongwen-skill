{
  "name": "gongwen-skill",
  "version": "2.16.0",
  "description": "公文全流程处理专家 - GB/T 9704 公文内容生成（模板/Markdown转公文）/格式检查修复/内容优化/版式注入",
  "type": "module",
  "main": "dsh/index.js",
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.2-0 <0.4.0"
  },
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./client": {
      "default": "./dsh/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "chinese",
    "document",
    "government",
    "format",
    "GB/T 9704",
    "docx",
    "official-document",
    "dsh",
    "deepseek-harness",
    "skill",
    "cordis",
    "config-panel"
  ],
  "author": "Jose AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linhut/gongwen-skill.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.1 || >=4.1.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-0 || >=0.1.5-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0 || >=0.2.2-0 || >=0.2.3-0",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.2-0 || >=0.1.5-0 || >=0.2.0-0 || >=0.2.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings-plugins": { "optional": true }
  },
  "scripts": {
    "prepack": "node scripts/clean-cache.js",
    "bump": "node scripts/bump-version.js"
  },
  "files": [
    "dsh/",
    "engine/",
    "gongwen/",
    "rules/",
    "prompts/",
    "etc/",
    "presets/",
    "cordis.patch.yml",
    "SKILL.md",
    "pyproject.toml",
    "requirements.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    ".claude-plugin/"
  ]
}
